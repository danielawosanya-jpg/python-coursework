# Copy to /etc/coverage-gap-finder.env and chmod 600.
# These are secrets - never commit the filled-in version.

ADMIN_KEY=replace-with-24-random-characters
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=you@youragency.com
SMTP_PASS=your-app-password
SMTP_FROM=Your Name <you@youragency.com>
